<?xml version="1.0" encoding="utf-8"?>
<!--
  Small widget layout (2x2)
  - Just the life clock time + city name + period badge.
  - Compact and readable at a glance.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_digital"
    android:padding="14dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/widget_label"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:letterSpacing="0.05"
        android:fontFamily="sans-serif-medium"
        tools:text="TEHRAN"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextClock
        android:id="@+id/widget_life_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/digital_text"
        android:textSize="44sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        tools:text="06:45"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/widget_life_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/life_clock"
        android:textColor="@color/widget_label"
        android:textSize="10sp"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/widget_period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/digital_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="MORNING"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- Hidden slots for IDs that the renderer always touches but small widget
         doesn't visually show. Adding them as gone-size-zero prevents any
         "Can't load widget" issues from setTextColor/setString on missing IDs. -->
    <TextClock
        android:id="@+id/widget_official_clock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_sunrise"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_sunset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_progress_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_persian_date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_day_length"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
